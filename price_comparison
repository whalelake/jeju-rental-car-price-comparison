    def extract_car_info(self, api_data, debug=False):
        """
        API 응답에서 차량 정보를 추출합니다.
        """
        if not api_data or api_data.get('result') != 1:
            return []
        
        # 연료 타입 매핑
        fuel_type_mapping = {
            1: '휘발유',
            2: '경유',
            3: 'LPG',
            4: '전기',
            5: '하이브리드',
            '1': '휘발유',
            '2': '경유',
            '3': 'LPG',
            '4': '전기',
            '5': '하이브리드'
        }
        
        extracted_data = []
        car_list = api_data.get('carList', [])
        
        for i, car_group in enumerate(car_list):
            # carModel 정보 - bottomCarInfo에서 가져오기
            car_model = ""
            if 'bottomCarInfo' in car_group:
                car_model = car_group['bottomCarInfo'].get('carModel', '')
            if not car_model and 'topCarInfo' in car_group:
                car_model = car_group['topCarInfo'].get('topCarName', '')
            
            car_info_list = car_group.get('list', [])
            
            for j, car_info in enumerate(car_info_list):
                company_name = clean_vendor_name(car_info.get('companyName', ''))
                cars = car_info.get('cars', [])
                
                for k, car in enumerate(cars):
                    # 실제 구조에 맞게 데이터 추출
                    if car.get('price') is not None:
                        # 기본 가격
                        base_price = car.get('price', 0)
                        
