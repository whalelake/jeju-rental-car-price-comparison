                    if first_year.startswith('Y_'):
                        model_year_processed = first_year[2:]  # Y_ 제거
                    else:
                        model_year_processed = first_year
                
                # 데이터 저장 - CAR_NAME을 원본명으로 초기 설정
                row_data = {
                    'VENDOR': vendor,
                    'CAR_NAME': erp_name,  # 일단 원본명으로 설정
                    'PRICE': total_price,  # 기본료 + 모든 보험료
                    'FUEL_TYPE': fuel_type,
                    'MODEL_YEAR': model_year_processed,
                    'CAPACITY': seat_cnt,
                    'PLATFORM': '찜카',
                    'ORIGINAL_NAME': erp_name,  # 정규화 기준이 되는 원본명
                    'ORIGIN_PRICE': base_sale_fee,  # 기본료만 저장
                    'MARGIN': additional_fee,  # 보험료를 MARGIN으로 저장
                    'MARGIN_RATE': None
                }
                
                extracted_data.append(row_data)
                    
            except Exception as e:
                continue
        
        # DataFrame 생성
        df = pd.DataFrame(extracted_data)
        
        if not df.empty:
            # 가격 데이터 숫자형으로 변환
            df['PRICE'] = pd.to_numeric(df['PRICE'], errors='coerce').fillna(0).astype(int)
            if 'ORIGIN_PRICE' in df.columns:
                df['ORIGIN_PRICE'] = pd.to_numeric(df['ORIGIN_PRICE'], errors='coerce').fillna(0).astype(int)
            if 'MARGIN' in df.columns:
                df['MARGIN'] = pd.to_numeric(df['MARGIN'], errors='coerce').fillna(0).astype(int)
            
            # 차량명 분석 추가
            df = enhance_dataframe_with_parsed_info(df)
        
        print(f"✅ 찜카 수집: {len(df)}건")
        return df
        
    except requests.exceptions.RequestException as e:
        print(f"🚫 찜카 네트워크 오류: {e}")
        return pd.DataFrame()
    except Exception as e:
        print(f"🚫 찜카 예상치 못한 오류: {e}")
        return pd.DataFrame()

def convert_date_formats(sd, st, ed, et):
    # YYYYMMDD → YYYY-MM-DD
    if "-" not in sd:
        sd = datetime.strptime(sd, "%Y%m%d").strftime("%Y-%m-%d")
        ed = datetime.strptime(ed, "%Y%m%d").strftime("%Y-%m-%d")
    # HHMM → HH:MM
    def to_hm(x):
        # 콜론이 있는지 확인하고 적절히 처리
        if ":" in x:
            return x
        else:
            # 길이가 4이상인지 확인
            if len(x) >= 4:
                return f"{x[:2]}:{x[2:]}"
            else:
                # 입력이 짧을 경우(예: '9'를 '09:00'으로)
                return f"{x.zfill(2)}:00"
    
    hm_s, hm_e = to_hm(st), to_hm(et)
    
    # JejuPass용 HHMM - 콜론 제거
    jp_s = st.replace(":", "") if ":" in st else st
    jp_e = et.replace(":", "") if ":" in et else et
    
    return {
        "std": {"sd": sd, "st": hm_s, "ed": ed, "et": hm_e},
        "jeju": {"bd": sd, "bt": jp_s, "ed": ed, "et": jp_e},
    }

def generate_date_range(start_day=1, end_day=2):
    jobs = []
    for d in range(start_day, end_day + 1):
        base = datetime.today() + timedelta(days=d)
        for term in TRAVEL_TERMS:
            end_dt = base + timedelta(days=term)
            jobs.append({
                "sd": base.strftime("%Y-%m-%d"),
                "st": "0900",
                "ed": end_dt.strftime("%Y-%m-%d"),
                "et": "0900"
            })
    return jobs

