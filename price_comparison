def create_carname_edit(df):
    """
    CARNAME_EDIT 컬럼을 생성하는 함수 (vendor-car_name-fuel_type-model_year 형식)
    중복 정보 제거 및 정리된 형식으로 생성
    """
    if df.empty:
        return df
    
    carname_edit_values = []
    
    for idx, row in df.iterrows():
        # 각 필드 값 가져오기 (빈 값 처리)
        vendor = str(row.get('VENDOR', '')).strip() if pd.notna(row.get('VENDOR')) else ''
        car_name = str(row.get('CAR_NAME', '')).strip() if pd.notna(row.get('CAR_NAME')) else ''
        fuel_type = str(row.get('FUEL_TYPE', '')).strip() if pd.notna(row.get('FUEL_TYPE')) else ''
        model_year = str(row.get('MODEL_YEAR', '')).strip() if pd.notna(row.get('MODEL_YEAR')) else ''
        
        # MODEL_YEAR에서 숫자만 추출 (2022.0 -> 2022)
        if model_year and '.' in model_year:
            model_year = model_year.split('.')[0]
        
        # FUEL_TYPE 정리 (중복 제거 및 표준화)
        if fuel_type:
            # 중복된 연료타입 정리
            fuel_parts = fuel_type.split()
            unique_fuel_parts = []
            for part in fuel_parts:
                if part not in unique_fuel_parts:
                    unique_fuel_parts.append(part)
            fuel_type = ' '.join(unique_fuel_parts)
        
        # CAR_NAME에서 이미 포함된 정보 제거
        clean_car_name = car_name
        if fuel_type and fuel_type in clean_car_name:
            clean_car_name = clean_car_name.replace(fuel_type, '').strip()
        if model_year and model_year in clean_car_name:
            clean_car_name = clean_car_name.replace(model_year, '').strip()
        
        # 연속된 공백과 특수문자 정리
        clean_car_name = re.sub(r'[-\s]+', ' ', clean_car_name).strip()
        clean_car_name = clean_car_name.strip('- ')
        
        # 하이픈으로 연결 (빈 값은 빈 문자열로)
        carname_edit = f"{vendor}-{clean_car_name}-{fuel_type}-{model_year}"
        carname_edit_values.append(carname_edit)
    
    # CARNAME_EDIT 컬럼 추가
    df['CARNAME_EDIT'] = carname_edit_values
    
    return df

