def create_price_comparison_pivot(df):
    """
    플랫폼별 가격 비교를 위한 피벗 테이블을 생성하는 함수
    제주패스의 랭킹, 가격차이, 조정마진 계산 포함
    """
    if df.empty:
        return pd.DataFrame()
    
    # CARNAME_EDIT을 기준으로 그룹화하여 플랫폼별 최저 가격 추출
    pivot_data = []
    
    # CARNAME_EDIT별로 그룹화
    grouped = df.groupby('CARNAME_EDIT')
    
    for carname_edit, group in grouped:
        # 각 플랫폼별 최저 가격 찾기
        platform_prices = {}
        jeju_pass_info = {}  # 제주패스 추가 정보 저장
        
        for platform in group['PLATFORM'].unique():
            platform_data = group[group['PLATFORM'] == platform]
            if not platform_data.empty:
                # 최저 가격 행 찾기
                min_price_idx = platform_data['PRICE'].idxmin()
                min_price_row = platform_data.loc[min_price_idx]
                min_price = min_price_row['PRICE']
                platform_prices[platform] = min_price
                
                # 제주패스인 경우 추가 정보 저장 (숫자형으로 안전하게 변환)
                if platform == '제주패스':
                    def safe_numeric_convert(value, default=0):
                        try:
                            return float(value) if value is not None and str(value).strip() != '' else default
                        except (ValueError, TypeError):
                            return default
                    
                    jeju_pass_info = {
                        '제주패스_원가': safe_numeric_convert(min_price_row.get('ORIGIN_PRICE'), 0),
                        '제주패스_마진': safe_numeric_convert(min_price_row.get('MARGIN'), 0),
                        '제주패스_마진율': safe_numeric_convert(min_price_row.get('MARGIN_RATE'), 0),
                        '제주패스_업체코드': str(min_price_row.get('ENTRPS_CODE', '')),
                        '제주패스_차량코드': str(min_price_row.get('CAR_CODE', ''))
                    }
        
        # 결과 행 생성
        row = {'차량정보': carname_edit}
        row.update(platform_prices)
        row.update(jeju_pass_info)  # 제주패스 추가 정보 포함
        
        # 가격 리스트 생성 (제주패스 포함된 경우만)
        if '제주패스' in platform_prices:
            prices = list(platform_prices.values())
            jeju_pass_price = platform_prices['제주패스']
            
            # 가격 순으로 정렬하여 순위 매기기
            sorted_platforms = sorted(platform_prices.items(), key=lambda x: x[1])
            
            # 제주패스 순위 찾기
            jeju_pass_rank = next((i+1 for i, (platform, price) in enumerate(sorted_platforms) if platform == '제주패스'), None)
            row['RANKING'] = jeju_pass_rank
            
            # 기본 정보
            row['최저가'] = min(prices)
            row['최고가'] = max(prices)
            row['가격차이'] = max(prices) - min(prices)
            
            # 제주패스 원가 및 마진율 정보 (이미 숫자형으로 변환됨)
            origin_price = jeju_pass_info.get('제주패스_원가', 0)
            current_margin_rate = jeju_pass_info.get('제주패스_마진율', 0)
            
            # PRICE_COMPARE 및 조정마진 계산
            if jeju_pass_rank == 1:
                # 제주패스가 1위인 경우 - 2위와 비교
                if len(sorted_platforms) >= 2:
                    second_platform, second_price = sorted_platforms[1]
                    price_diff = second_price - jeju_pass_price
                    row['PRICE_COMPARE'] = price_diff
                    
                    # 2위와의 차이가 10% 이상인지 확인
                    if jeju_pass_price > 0:
                        diff_percentage = (price_diff / jeju_pass_price) * 100
                        
                        if diff_percentage >= 10:
                            # 10% 이상 차이나면 마진을 높일 수 있음
                            # 새로운 목표 가격: 2위 가격의 95% (5% 정도 낮게)
                            target_price = second_price * 0.95
                            if origin_price > 0:
                                new_margin = target_price - origin_price
                                new_margin_rate = (new_margin / origin_price) * 100
                                row['제주패스조정마진'] = round(new_margin_rate, 1)
                            else:
                                row['제주패스조정마진'] = current_margin_rate
                        else:
                            # 10% 미만 차이면 기존 마진 유지
                            row['제주패스조정마진'] = current_margin_rate
                    else:
                        row['제주패스조정마진'] = current_margin_rate
                else:
                    row['PRICE_COMPARE'] = 0
                    row['제주패스조정마진'] = current_margin_rate
                    
            else:
                # 제주패스가 1위가 아닌 경우 - 1위와 비교
                first_platform, first_price = sorted_platforms[0]
                price_diff = first_price - jeju_pass_price  # 음수가 될 것
                row['PRICE_COMPARE'] = price_diff
                
                # 1위가 되기 위한 목표 가격: 1위 가격보다 1% 낮게
                target_price = first_price * 0.99
                
                if origin_price > 0:
                    # 목표 가격을 달성하기 위한 마진 계산
                    required_margin = target_price - origin_price
                    required_margin_rate = (required_margin / origin_price) * 100
                    
                    # 마진율이 10% 이하로 떨어지는지 확인
                    if required_margin_rate <= 10:
                        # 10% 이하로 떨어지면 기존 마진율 유지
                        row['제주패스조정마진'] = current_margin_rate
                    else:
                        # 10% 초과하면 새로운 마진율 적용
                        row['제주패스조정마진'] = round(required_margin_rate, 1)
                else:
                    row['제주패스조정마진'] = current_margin_rate
            
            # 제주패스가 최저가인지 확인
            if jeju_pass_price == min(prices):
                row['제주패스_최저가여부'] = 'Y'
            else:
                row['제주패스_최저가여부'] = 'N'
        else:
            # 제주패스가 없는 경우
            prices = list(platform_prices.values())
            if prices:
                row['최저가'] = min(prices)
                row['최고가'] = max(prices)
                row['가격차이'] = max(prices) - min(prices)
            row['RANKING'] = None
            row['PRICE_COMPARE'] = None
            row['제주패스조정마진'] = None
            row['제주패스_최저가여부'] = 'N'
        
        pivot_data.append(row)
    
    comparison_df = pd.DataFrame(pivot_data)
    
    # 조정마진금액 계산 (기존마진액 - 변경마진액)
    for idx, row in comparison_df.iterrows():
        if pd.notna(row.get('제주패스_원가')) and pd.notna(row.get('제주패스_마진율')) and pd.notna(row.get('제주패스조정마진')):
            origin_price = row['제주패스_원가']
            current_margin_rate = row['제주패스_마진율']
            adjusted_margin_rate = row['제주패스조정마진']
            
            if origin_price > 0:
                # 기존 마진액
                current_margin_amount = origin_price * (current_margin_rate / 100)
                # 조정 마진액
                adjusted_margin_amount = origin_price * (adjusted_margin_rate / 100)
                # 마진 변화액 (기존 - 조정)
                margin_diff = current_margin_amount - adjusted_margin_amount
                comparison_df.loc[idx, '조정마진금액'] = round(margin_diff, 0)
            else:
                comparison_df.loc[idx, '조정마진금액'] = 0
        else:
            comparison_df.loc[idx, '조정마진금액'] = 0
    
    # 컬럼 순서 정리 (요청된 순서대로)
    desired_cols = [
        '차량정보', '제주패스', '찜카', '카모아', 'RANKING', 'PRICE_COMPARE', 
        '제주패스_원가', '제주패스_마진', '제주패스_마진율', '제주패스_업체코드', '제주패스_차량코드',
        '최저가', '최고가', '가격차이', '제주패스_최저가여부', '검색일자', '여행기간', 
        '제주패스조정마진', '조정마진금액'
    ]
    
    # 돌하루팡 컬럼이 있다면 찜카와 카모아 사이에 추가
    if '돌하루팡' in comparison_df.columns:
        # 찜카 다음에 돌하루팡 삽입
        final_cols = []
        for col in desired_cols:
            final_cols.append(col)
            if col == '찜카':
                final_cols.append('돌하루팡')
        desired_cols = final_cols
    
    # 존재하는 컬럼만 선택
    existing_cols = [col for col in desired_cols if col in comparison_df.columns]
    
    # 누락된 필수 컬럼이 있다면 추가 (빈 값으로)
    for col in ['검색일자', '여행기간']:
        if col not in comparison_df.columns:
            comparison_df[col] = ''
            existing_cols.append(col)
    
    comparison_df = comparison_df[existing_cols]
    
    return comparison_df

def normalize_car_names(df):
    """
    차량명을 표준화하는 함수 - ORIGINAL_NAME 기준으로 처리하되, 없으면 CAR_NAME 사용
    """
    if df.empty:
        return df
    
    # ORIGINAL_NAME이 없으면 CAR_NAME을 ORIGINAL_NAME으로 복사
    if 'ORIGINAL_NAME' not in df.columns:
        if 'CAR_NAME' in df.columns:
            df['ORIGINAL_NAME'] = df['CAR_NAME'].copy()
        else:
            return df
    
    # MODEL_YEAR를 정수로 변환 (안전하게)
    def safe_int_conversion(year_value):
        try:
            if pd.isna(year_value) or year_value == '' or year_value is None:
                return None
            return int(float(str(year_value)))
        except (ValueError, TypeError):
            return None
    
    for idx, row in df.iterrows():
        # ORIGINAL_NAME을 기준으로 정규화 적용 (없으면 CAR_NAME 사용)
        name_for_analysis = row.get('ORIGINAL_NAME') or row.get('CAR_NAME', '')
        original_name = str(name_for_analysis).strip().lower() if pd.notna(name_for_analysis) else ''
        model_year = safe_int_conversion(row.get('MODEL_YEAR', None))
        
        # 정규화 적용 전에 차량명이 매칭되는지 확인
        car_matched = False
        
        # 1. 그랜저 처리
        if '그랜저' in original_name:
            if model_year and model_year <= 2020:
                df.loc[idx, 'CAR_NAME'] = '그랜저IG'
            elif model_year and model_year >= 2021:
                df.loc[idx, 'CAR_NAME'] = '그랜저GN7'
            else:
                df.loc[idx, 'CAR_NAME'] = '그랜저'
            car_matched = True
        
        # 2. 스타렉스 처리
        elif '스타렉스' in original_name:
            if '교통약자' in original_name and '리프트' in original_name:
                df.loc[idx, 'CAR_NAME'] = name_for_analysis  # 그대로 유지
            else:
                df.loc[idx, 'CAR_NAME'] = '그랜드스타렉스'
            car_matched = True
        
        # 3. K5 처리
        elif 'k5' in original_name:
            df.loc[idx, 'CAR_NAME'] = 'K5'
            car_matched = True
        
        # 4. K3 처리
        elif 'k3' in original_name:
            if model_year and model_year <= 2021:
                df.loc[idx, 'CAR_NAME'] = '올 뉴 K3'
            elif model_year and model_year >= 2022:
                df.loc[idx, 'CAR_NAME'] = '더 뉴 K3'
            else:
                df.loc[idx, 'CAR_NAME'] = 'K3'
            car_matched = True
        
        # 5. K7 처리
        elif 'k7' in original_name:
            df.loc[idx, 'CAR_NAME'] = 'K7'
            car_matched = True
        
        # 6. K8 처리
        elif 'k8' in original_name:
            df.loc[idx, 'CAR_NAME'] = 'K8'
            car_matched = True
        
        # 7. K9 처리
        elif 'k9' in original_name:
            df.loc[idx, 'CAR_NAME'] = 'K9'
