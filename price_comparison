            return pd.DataFrame()
        
        # API 호출을 위한 헤더 설정 (AJAX 요청용)
        api_headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
            'Accept': 'application/json, text/plain, */*',
            'Accept-Language': 'ko-KR,ko;q=0.9,en;q=0.8',
            'Accept-Encoding': 'gzip, deflate, br',
            'Connection': 'keep-alive',
            'Referer': main_url,
            'Origin': 'https://rent-car.zzimcar.com',
            'Sec-Fetch-Dest': 'empty',
            'Sec-Fetch-Mode': 'cors',
            'Sec-Fetch-Site': 'cross-site',
            'X-Requested-With': 'XMLHttpRequest'
        }
        
        # API URL 설정
        api_url = "https://nm-api.io/api/internal/v1/car/list"
        
        # POST 데이터
        post_data = {
            'sdate': sdate,
            'edate': edate,
            'zone': 'JEJU',
            'bohum': 'full'
        }
        
        # POST 요청으로 시도
        api_response = session.post(api_url, headers=api_headers, json=post_data, timeout=30)
        
        # POST가 실패하면 GET으로 다시 시도
        if api_response.status_code != 200:
            params = {
                'sdate': sdate,
                'edate': edate,
                'zone': 'JEJU',
                'bohum': 'full'
            }
            api_response = session.get(api_url, headers=api_headers, params=params, timeout=30)
            
        # 둘 다 실패하면 다른 형식으로 시도
        if api_response.status_code != 200:
            # Content-Type을 form-data로 변경
            api_headers_form = api_headers.copy()
            api_headers_form['Content-Type'] = 'application/x-www-form-urlencoded'
            api_response = session.post(api_url, headers=api_headers_form, data=post_data, timeout=30)
            
        # 마지막으로 query string으로 시도
        if api_response.status_code != 200:
            query_url = f"{api_url}?sdate={sdate}&edate={edate}&zone=JEJU&bohum=full"
            api_response = session.get(query_url, headers=api_headers, timeout=30)
        
        # 모든 방법이 실패한 경우
        if api_response.status_code != 200:
            print(f"🚫 찜카 API 호출 실패: {api_response.status_code}")
            
            # 대안 엔드포인트 시도
            alternative_endpoints = [
                "https://nm-api.io/api/v1/car/list",
                "https://nm-api.io/api/car/list", 
                "https://nm-api.io/car/list",
                "https://rent-car.zzimcar.com/api/car/list"
            ]
            
            for alt_url in alternative_endpoints:
                try:
                    alt_response = session.get(alt_url, headers=api_headers, params={'sdate': sdate, 'edate': edate}, timeout=10)
                    if alt_response.status_code == 200:
                        api_response = alt_response
                        break
                except:
                    continue
            
            if api_response.status_code != 200:
                print("🚫 찜카: 모든 API 호출 방법 실패")
                return pd.DataFrame()
        
        # JSON 데이터 파싱
        try:
            data = api_response.json()
        except json.JSONDecodeError as e:
            print(f"🚫 찜카 JSON 파싱 실패: {e}")
            return pd.DataFrame()
        
        # 데이터 추출
        extracted_data = []
        
        # data가 리스트인 경우
        if isinstance(data, list):
            car_list = data
        # data가 딕셔너리이고 특정 키에 리스트가 있는 경우
        elif isinstance(data, dict):
            # 가능한 키들을 확인
            possible_keys = ['data', 'list', 'cars', 'items', 'results']
            car_list = None
            
            for key in possible_keys:
                if key in data and isinstance(data[key], list):
                    car_list = data[key]
                    break
            
            if car_list is None:
                print("🚫 찜카: 데이터 리스트를 찾을 수 없습니다.")
                return pd.DataFrame()
        else:
            print(f"🚫 찜카: 예상하지 못한 데이터 형태: {type(data)}")
            return pd.DataFrame()
        
        # 각 차량 데이터 처리
        for i, car_item in enumerate(car_list):
            try:
                if not isinstance(car_item, dict):
                    continue
                
                # 기본 정보 추출
                vendor = clean_vendor_name(car_item.get('agency', {}).get('agencyName', ''))
                erp_name = car_item.get('erpName', '')
                fuel_code = car_item.get('fuelCode', '')
                base_sale_fee = car_item.get('saleFee', 0)
                seat_cnt = car_item.get('seatCnt', 0)
                years_code = car_item.get('yearsCode', '')
                
                # 보험료 계산 로직
                additional_fee = 0
                bohum_list = car_item.get('bohum', [])
                
