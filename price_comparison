                        # 데이터 추출 - CAR_NAME을 원본명으로 초기 설정
                        row_data = {
                            'VENDOR': company_name,
                            'CAR_NAME': car_model,  # 일단 원본명으로 설정
                            'PRICE': final_price,  # CDW 보험료가 포함된 최종 가격
                            'FUEL_TYPE': fuel_type,
                            'MODEL_YEAR': car.get('minYear', ''),
