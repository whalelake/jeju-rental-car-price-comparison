def clean_vendor_name(vendor_name):
    """
    렌터카 업체명을 정리하는 함수
    """
    if not vendor_name:
        return ""
    
    # 기본 정리
    cleaned = vendor_name.replace(" ", "").replace("렌트카", "").replace("렌터카", "").replace("더", "").replace("R", "").replace("국제","조아").replace("씽씽","제주야").replace("차세대","자보")
    
    # 특정 제주 업체들에서만 "제주" 제거
    jeju_companies = ["매일", "아산", "알프스", "자연", "카카", "타요", "탐라", "평화", "한라", "OK", "공항"]
    
    # 제주로 시작하고 위 업체명 중 하나를 포함하는 경우만 제주 제거
    if cleaned.startswith("제주"):
        for company in jeju_companies:
            if company in cleaned:
                cleaned = cleaned.replace("제주", "", 1)  # 첫 번째 "제주"만 제거
                break
    
    return cleaned

def parse_car_name(original_name):
    """
    차량명에서 세대 정보, 연료 타입, 연식만 분리하는 함수
    차량명은 건드리지 않음
    
    Args:
        original_name (str): 원본 차량명
    
    Returns:
        dict: 분리된 정보 (gen, fuel_type, model_year만)
    """
    if not original_name or pd.isna(original_name):
        return {"gen": None, "fuel_type": None, "model_year": None}
    
    result = {"gen": None, "fuel_type": None, "model_year": None}
    
    # 분석할 차량명 복사본 생성
    clean_name = str(original_name).strip()
    
    # 1. 세대 정보 추출 (숫자+세대)
    gen_pattern = r'(\d+세대)'
    gen_match = re.search(gen_pattern, clean_name)
    if gen_match:
        result["gen"] = gen_match.group(1)
    
    # 2. 연료 타입 추출
    fuel_types = ['휘발유', 'LPG', '전기', '경유', '하이브리드', '전기차']
    for fuel in fuel_types:
        if fuel in clean_name:
            result["fuel_type"] = fuel
            break
    
    # 3. 연식 추출 (YYYY 형식)
    year_patterns = [
        r'\b(19\d{2}|20\d{2})\b',  # 기본 연도 패턴
        r'^(19\d{2}|20\d{2})\s+',  # 문자열 시작 부분의 연도
        r'\s+(19\d{2}|20\d{2})$',  # 문자열 끝 부분의 연도
        r'(19\d{2}|20\d{2})\s*년',  # 연도 + '년'
        r'(19\d{2}|20\d{2})\s*년형',  # 연도 + '년형'
    ]
    
    for pattern in year_patterns:
        year_match = re.search(pattern, clean_name)
        if year_match:
            result["model_year"] = year_match.group(1)
            break
    
    return result

