def run_auto_mode(start_day=1, end_day=2):
    """콘솔용 자동 모드"""
    print(f"🔄 자동 모드 {start_day}~{end_day}일")
    jobs = generate_date_range(start_day, end_day)
    all_dfs = []
    all_comparisons = []  # 가격 비교 결과를 저장할 리스트 추가
    
    for j in jobs:
        fmt = convert_date_formats(j["sd"], j["st"], j["ed"], j["et"])
        
        # 4개 플랫폼 수집
        df1 = fetch_jeju_pass_filtered(**fmt["jeju"])
        df2 = process_dolharupang_data(fetch_dolharupang_data(
            fmt["std"]["sd"], fmt["std"]["st"], fmt["std"]["ed"], fmt["std"]["et"]))
        df3 = fetch_carmore_data(fmt["std"]["sd"], fmt["std"]["st"], fmt["std"]["ed"], fmt["std"]["et"])
        df4 = fetch_zzimcar_data(fmt["std"]["sd"], fmt["std"]["st"], fmt["std"]["ed"], fmt["std"]["et"])

        # 수집 데이터 통합
        dfs = [df for df in (df1, df2, df3, df4) if not df.empty]
        df_all = pd.concat(dfs, ignore_index=True) if dfs else pd.DataFrame()
        if df_all.empty:
            continue

        df_all["SEARCH_DATE"] = datetime.now().strftime("%Y-%m-%d")
        
        # 날짜/시간 정보 추가
        df_all["SDATE"] = fmt["std"]["sd"]
        df_all["STIME"] = fmt["std"]["st"]
        df_all["EDATE"] = fmt["std"]["ed"]
        df_all["ETIME"] = fmt["std"]["et"]

        # 가격 비교 테이블 생성 추가
        comparison_df = create_price_comparison_pivot(df_all)
        comparison_df['검색일자'] = j["sd"]
        comparison_df['여행기간'] = f"{j['sd']} ~ {j['ed']}"

        folder = os.path.join(SAVE_DIR, datetime.today().strftime("%Y%m%d"))
        os.makedirs(folder, exist_ok=True)
        
        # 원본 데이터 저장
        fname = f"비교_{j['sd']}_{j['ed']}_{datetime.now().strftime('%H%M%S')}.csv"
        df_all.to_csv(os.path.join(folder, fname), index=False, encoding="utf-8-sig")
        
        # 가격 비교 테이블 저장 추가
        fname_comparison = f"가격비교_{j['sd']}_{j['ed']}_{datetime.now().strftime('%H%M%S')}.xlsx"
        comparison_df.to_excel(os.path.join(folder, fname_comparison), index=False)
        
        print("✅ 원본 저장:", fname)
        print("✅ 가격비교 저장:", fname_comparison)
        
        all_dfs.append(df_all)
        all_comparisons.append(comparison_df)  # 가격 비교 결과 추가

    if all_dfs:
        big = pd.concat(all_dfs, ignore_index=True)
        big_comparison = pd.concat(all_comparisons, ignore_index=True)  # 통합 가격 비교
        
        folder = os.path.join(SAVE_DIR, datetime.today().strftime("%Y%m%d"))
        fn = f"test_통합전체_{datetime.now().strftime('%H%M%S')}.csv"
        fn_comparison = f"통합가격비교_{datetime.now().strftime('%H%M%S')}.xlsx"  # 추가
        
        big.to_csv(os.path.join(folder, fn), index=False, encoding="utf-8-sig")
        big_comparison.to_excel(os.path.join(folder, fn_comparison), index=False)  # 추가
        
        print(f"✅ 전체 통합 저장: {fn} (총 {len(big)}건)")
        print(f"✅ 통합 가격비교 저장: {fn_comparison}")  # 추가

