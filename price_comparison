                if isinstance(bohum_list, list) and len(bohum_list) > 0:
                    for bohum_item in bohum_list:
                        if isinstance(bohum_item, dict):
                            # "full" 타입 또는 "고급자차" 이름을 가진 보험만 선택
                            bohum_type = bohum_item.get('type', '')
                            bohum_name = bohum_item.get('name', '')
                            
                            if bohum_type == 'full' or '고급자차' in bohum_name:
                                additional_fee = bohum_item.get('saleFee', 0)
                                break  # 고급자차 찾으면 중단
                
                # 최종 가격 계산: 기본료 + 선택된 보험료
                total_price = base_sale_fee + additional_fee
                
