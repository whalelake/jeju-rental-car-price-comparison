def process_dolharupang_data(data):
    if not isinstance(data, dict):
        return pd.DataFrame()
    
    car_data = data.get("data", {})
    out, cnt, tot = [], 0, 0
    
    def extract_year_from_any_field(package_name, make_year_info):
        """여러 필드에서 연도를 찾아 추출"""
        import re
        
        # 1. makeYearInfo에서 먼저 시도
        if make_year_info:
            if isinstance(make_year_info, str):
                year_match = re.search(r'\b(19\d{2}|20\d{2})\b', make_year_info)
                if year_match:
                    return year_match.group(1)
            elif isinstance(make_year_info, (int, float)):
                year_str = str(int(make_year_info))
                if len(year_str) == 4 and year_str.startswith(('19', '20')):
                    return year_str
        
        # 2. packageNmTmpl에서 시도
        if package_name:
            year_match = re.search(r'\b(19\d{2}|20\d{2})\b', str(package_name))
            if year_match:
                return year_match.group(1)
        
        return ""
    
    def extract_fuel_type_from_packageNmTmpl(package_name):
        """packageNmTmpl에서 연료 타입 추출"""
        if not package_name:
            return ""
        
        # 연료 타입 키워드 정의 (우선순위 순서로 배치)
        fuel_keywords = [
            ('하이브리드', '하이브리드'),
            ('전기', '전기'),
            ('경유', '경유'),
            ('휘발유', '휘발유'),
            ('LPG', 'LPG'),
            ('lpg', 'LPG'),  # 소문자도 처리
        ]
        
        package_name_str = str(package_name)
        
        # 각 연료 타입 키워드를 확인
        for keyword, fuel_type in fuel_keywords:
            if keyword in package_name_str:
                return fuel_type
        
        return ""
    
    def extract_car_name_from_packageNmTmpl(package_name):
        """packageNmTmpl에서 실제 차량명만 추출"""
        if not package_name:
            return ""
        
        # 차량명 매핑 딕셔너리 (packageNmTmpl에서 실제 차량명으로)
        car_mapping = {
            # 기아차
            '모닝': '모닝', 'K3': 'K3', 'K5': 'K5', 'K7': 'K7', 'K8': 'K8', 'K9': 'K9',
            '니로': '니로', '셀토스': '셀토스', '쏘렌토': '쏘렌토', '쏘울': '쏘울', 
            '스포티지': '스포티지', '카니발': '카니발', '모하비': '모하비',
            'EV6': 'EV6', 'EV9': 'EV9', 'EV5': 'EV5', 'EV3': 'EV3',
            
            # 현대차
            '아반떼': '아반떼', '쏘나타': '쏘나타', '그랜저': '그랜저',
            '투싼': '투싼', '싼타페': '싼타페', '팰리세이드': '팰리세이드',
            '코나': '코나', '베뉴': '베뉴', '캐스퍼': '캐스퍼', '레이': '레이',
            '아이오닉5': '아이오닉5', '아이오닉6': '아이오닉6',
            '스타리아': '스타리아', '스타렉스': '그랜드스타렉스',
            
            # 제네시스
            'G70': '제네시스 G70', 'G80': '제네시스 G80', 'G90': '제네시스 G90',
            'GV60': '제네시스 GV60', 'GV70': '제네시스 GV70', 'GV80': '제네시스 GV80',
            '제네시스': '제네시스',
            
            # 쌍용차
            '코란도': '코란도', '티볼리': '티볼리', '쏠라티': '쏠라티',
            
            # 수입차
            '벤츠': '벤츠', 'BMW': 'BMW', '아우디': '아우디', '볼보': '볼보',
            '미니': '미니쿠퍼', '지프': '지프랭글러', '폴스타': '폴스타',
            '머스탱': '머스탱', '말리부': '말리부', '트랙스': '트랙스',
            'MASTER': '마스터'
        }
        
        package_str = str(package_name).strip()
        
        # 매핑된 차량명 찾기 (긴 이름부터 우선 매칭)
        sorted_mapping = sorted(car_mapping.items(), key=lambda x: len(x[0]), reverse=True)
        for key, value in sorted_mapping:
            if key in package_str:
                return value
        
        # 매핑되지 않은 경우, 첫 번째 단어 추출
        if ',' in package_str:
            first_part = package_str.split(',')[0].strip()
        else:
            words = package_str.split()
            first_part = words[0] if words else package_str
        
        return first_part if first_part else "기타"
    
    # 디버깅을 위한 로그 추가
    if isinstance(car_data, list) and len(car_data) > 0:
        print("🔍 돌하루팡 첫 번째 아이템 구조:")
        first_item = car_data[0]
        print(f"  keys: {list(first_item.keys())}")
        print(f"  makeYearInfo: '{first_item.get('makeYearInfo')}'")
        print(f"  packageNmTmpl: '{first_item.get('packageNmTmpl')}'")
    
    # car_data가 리스트인 경우와 딕셔너리인 경우를 모두 처리
    if isinstance(car_data, list):
        # 리스트 형태의 응답 처리
        for item in car_data:
            if not isinstance(item, dict):
                continue
            
            tot += 1
            
            # 각 아이템에서 필요한 정보 추출
            package_name = item.get("packageNmTmpl") or item.get("carName") or item.get("name", "")
            vendor = item.get("companyName") or item.get("vendor", "")
            price = item.get("priceTotal") or item.get("price", 0)
            capacity = item.get("capacityUser") or item.get("capacity", "")
            
            # 실제 차량명 추출
            car_name = extract_car_name_from_packageNmTmpl(package_name)
            
            # makeYearInfo에서 연도 추출
            make_year_info = item.get("makeYearInfo", "")
            model_year = extract_year_from_any_field(package_name, make_year_info)
            
            # packageNmTmpl에서 연료 타입 추출
            fuel_type = extract_fuel_type_from_packageNmTmpl(package_name)
            
            # 디버깅: 연도 추출 확인 (처음 3개만)
            if cnt < 3:
                print(f"  🔍 연도 추출 #{cnt+1}: makeYearInfo='{make_year_info}' → model_year='{model_year}'")
                print(f"  🔍 차량명 추출 #{cnt+1}: packageNmTmpl='{package_name}' → car_name='{car_name}'")
                print(f"  🔍 연료 추출 #{cnt+1}: fuel_type='{fuel_type}'")
            
            # 가격이 유효한지 확인
            if not price or price == 0:
                continue
            
            cnt += 1
            vendor_clean = clean_vendor_name(str(vendor))
            
            out.append({
                "VENDOR": vendor_clean,
                "CAR_NAME": car_name,  # 추출된 실제 차량명
                "PRICE": price,
                "FUEL_TYPE": fuel_type,  # packageNmTmpl에서 추출한 연료 타입
                "MODEL_YEAR": model_year,  # makeYearInfo에서 추출한 연도
                "CAPACITY": capacity,
                "PLATFORM": "돌하루팡",
                "ORIGINAL_NAME": package_name,  # 원본 packageNmTmpl 유지
                "ORIGIN_PRICE": None,
                "MARGIN": None,
                "MARGIN_RATE": None
            })
    
    elif isinstance(car_data, dict):
        # 기존 딕셔너리 형태의 응답 처리
        for pkg, info in car_data.items():
            deals = info.get("dealList", {})
            if not deals:
                continue
            for comp, d in deals.items():
                tot += 1
                valid_price = None
                # 완전자차 & 26세 필터
                for deal in d.get("deals", [d]):
                    if deal.get("insurType") == "완전자차" and int(deal.get("availableAge", 0)) == 26:
                        valid_price = deal.get("priceTotal")
                        break
                if valid_price is None:
                    continue
                cnt += 1
                comp2 = clean_vendor_name(comp)
                package_name = info.get("packageNmTmpl", "")
                
                # 실제 차량명 추출
                car_name = extract_car_name_from_packageNmTmpl(package_name)
                
                # makeYearInfo에서 연도 추출 (딕셔너리 형태에서도)
                make_year_info = info.get("makeYearInfo", "")
                model_year = extract_year_from_any_field(package_name, make_year_info)
                
                # packageNmTmpl에서 연료 타입 추출
                fuel_type = extract_fuel_type_from_packageNmTmpl(package_name)
                
                out.append({
                    "VENDOR": comp2,
                    "CAR_NAME": car_name,  # 추출된 실제 차량명
                    "PRICE": valid_price,
                    "FUEL_TYPE": fuel_type,  # packageNmTmpl에서 추출한 연료 타입
                    "MODEL_YEAR": model_year,  # makeYearInfo에서 추출한 연도
                    "CAPACITY": info.get("capacityUser", ""),
                    "PLATFORM": "돌하루팡",
                    "ORIGINAL_NAME": package_name,  # 원본 packageNmTmpl 유지
                    "ORIGIN_PRICE": None,
                    "MARGIN": None,
                    "MARGIN_RATE": None
                })
    
    df = pd.DataFrame(out)
    if not df.empty:
        df["PRICE"] = pd.to_numeric(df["PRICE"], errors="coerce").fillna(0).astype(int)
        # 차량명 분석 추가
        df = enhance_dataframe_with_parsed_info(df)
    print(f"✅ 돌하루팡 수집: {len(df)} ({cnt}/{tot})")
    return df
    
